{
  "name": "sessionport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "node packages/cli/src/index.ts",
    "test": "node --test packages/core/test/*.test.ts packages/adapters/*/test/*.test.ts packages/cli/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:desktop": "node --test apps/desktop/test/*.test.ts",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "build:desktop": "pnpm --dir apps/desktop build",
    "dist:desktop": "pnpm --dir apps/desktop dist",
    "release:prepare": "node scripts/prepare-npm.mjs",
    "pack:check": "node scripts/build-cli.mjs && node scripts/prepare-npm.mjs && rm -rf .tmp/pack && mkdir -p .tmp/pack && pnpm --filter sesport pack --pack-destination .tmp/pack",
    "build:cli": "node scripts/build-cli.mjs",
    "publish:cli": "node scripts/build-cli.mjs && node scripts/prepare-npm.mjs && pnpm --filter sesport publish --access public --no-git-checks"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "license": "Apache-2.0",
  "version": "0.1.6",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
